DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_rag
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
JWT_SECRET_BASE64=your_base64_secret_key
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=2592000000
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
INTERNAL_API_KEY=dev-internal-secret
OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
GENERATION_MAX_RETRIES=2
GENERATION_RETRY_BASE_DELAY_SECONDS=0.5
GENERATION_REQUEST_TIMEOUT_SECONDS=30
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
SPRING_PROFILES_ACTIVE=docker
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Backend runtime limits (small deployment defaults)
BACKEND_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.5
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
SERVER_MAX_THREADS=50
SERVER_MIN_SPARE_THREADS=2
DOCUMENT_LOG_LEVEL=INFO

# Optional pgAdmin tool profile limits
PGADMIN_MEMORY_LIMIT=512m
PGADMIN_CPU_LIMIT=0.5
