# =====================================================
# LMS-RAG
# Environment Variables Example
# Copy this file to ".env" and update the values.
# =====================================================


# =====================================================
# PostgreSQL
# =====================================================

# Database host
# - localhost: khi chạy Backend ngoài Docker
# - postgres : Docker Compose sẽ tự ghi đè cho Backend container
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database name
DB_NAME=lms_rag

# Database username
DB_USERNAME=postgres

# Database password
DB_PASSWORD=your_database_password


# =====================================================
# JWT
# =====================================================

# Base64 encoded secret key (>= 256 bits)
#
# Generate:
# https://www.base64encode.org/
#
# Example:
# openssl rand -base64 32
#
JWT_SECRET_BASE64=your_base64_secret_key

# Token expiration (milliseconds)
# 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000


# =====================================================
# pgAdmin
# =====================================================

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me


# =====================================================
# AI Service
# =====================================================

# Internal API key for Backend -> AI Service authentication
INTERNAL_API_KEY=dev-internal-secret

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# AI model configuration
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
GENERATION_MAX_RETRIES=2
GENERATION_RETRY_BASE_DELAY_SECONDS=0.5
GENERATION_REQUEST_TIMEOUT_SECONDS=30


# =====================================================
# Spring
# =====================================================

SPRING_PROFILES_ACTIVE=docker
