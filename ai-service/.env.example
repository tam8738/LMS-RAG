APP_ENV=local
APP_NAME=LMS RAG AI Service
OPENAI_API_KEY=
DATABASE_URL=postgresql://postgres:123456@localhost:5432/lms_rag
DB_CONNECT_TIMEOUT=5
INTERNAL_API_KEY=
UPLOAD_ROOT=/storage/uploads
MAX_FILE_SIZE_MB=20
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_DELAY_SECONDS=0.5
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
GENERATION_MAX_RETRIES=2
GENERATION_RETRY_BASE_DELAY_SECONDS=0.5
GENERATION_REQUEST_TIMEOUT_SECONDS=30
